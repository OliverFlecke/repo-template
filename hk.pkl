amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Builtins.pkl"

exclude = List("node_modules", "**/pnpm-lock.yaml", "dist", "build", "target")

local frontend = new Group {
	workspace_indicator = "pnpm.yaml"
	steps {
		["biome"] = Builtins.biome
		["sort-package-json"] = Builtins.sort_package_json
	}
}

local rust = new Group {
	workspace_indicator = "Cargo.toml"
	steps {
	["cargo_fmt"] = Builtins.cargo_fmt
	["cargo_clippy"] = Builtins.cargo_clippy
	["cargo_check"] = (Builtins.cargo_check) {
		profiles = List("ci", "full")
	}
  }
}

local dotnet = new Group {
	workspace_indicator = "*.csproj"
	steps {
		["dotnet-format"] {
			glob = List("**/*.csproj", "**/*.cs")
			check = "dotnet format --verify-no-changes --include {{files}}"
			fix = "dotnet format --include {{files}}"
			batch = true
		}
	}
}

local shared = new Mapping<String, Step> {
	["markdown"] = Builtins.markdown_lint
	["yaml"] = Builtins.yamllint
	["taplo"] = Builtins.taplo
	["taplo-fmt"] = Builtins.taplo_format
	["sql"] = Builtins.sql_fluff

	["actionlint"] = Builtins.actionlint
	["hadolint"] = Builtins.hadolint
	["docker-compose"] = Builtins.dclint

	["trailing-whitespace"] = Builtins.trailing_whitespace
	["mixed-line-ending"] = Builtins.mixed_line_ending
	["fix-smart-quotes"] = Builtins.fix_smart_quotes
	["check-case-conflict"] = Builtins.check_case_conflict
	["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
}

hooks {
	["pre-commit"] {
		fix = true
		stash = "git"
		steps = {
			["frontend"] = frontend,
			["rust"] = rust,
			...shared,
			["check-merge-conflict"] = Builtins.check_merge_conflict,
			["check-added-large-files"] = Builtins.check_added_large_files,
			["detect-private-key"] = Builtins.detect_private_key,
			["betterleaks"] = Builtins.betterleaks
		}
	}
	["commit-msg"] {
		steps {
			["check-conventional-commit"] {
				check = "hk util check-conventional-commit .git/COMMIT_EDITMSG"
			}
		}
	}
	["fix"] {
		fix = true
		steps = {
			["frontend"] = frontend,
			["rust"] = rust,
			["dotnet"] = dotnet,
			...shared,
		}
	}
	["check"] {
		steps = {
			["frontend"] = frontend,
			["rust"] = rust,
			...shared,
		}
	}
}
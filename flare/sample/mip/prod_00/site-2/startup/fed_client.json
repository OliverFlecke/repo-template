{
  "format_version": 2,
  "servers": [
    {
      "name": "mip",
      "service": {
        "target": "server:8002",
        "scheme": "http"
      },
      "identity": "server"
    }
  ],
  "client": {
    "ssl_private_key": "client.key",
    "ssl_cert": "client.crt",
    "ssl_root_cert": "rootCA.pem",
    "fqsn": "site-2",
    "is_leaf": true,
    "connection_security": "mtls"
  }
}
